  "buildPresets": {
    "note": "七个手动入口映射到目标子集；同一构建命令不得在多个工作流文件中复制维护。",
    "all": {
      "requiredTargets": [
        "windows-amd64", "windows-386", "windows-arm64",
        "android-arm64-v8a", "android-armeabi-v7a", "android-x86",
        "linux-amd64", "linux-386", "linux-arm64"
      ],
      "optionalTargets": ["docker-amd64", "docker-386", "docker-arm64"]
    },
    "windows": { "targets": ["windows-amd64", "windows-386", "windows-arm64"] },
    "android": { "targets": ["android-arm64-v8a", "android-armeabi-v7a", "android-x86"], "optionalAbi": "x86_64" },
    "linux": { "targets": ["linux-amd64", "linux-386", "linux-arm64"] },
    "docker": { "targets": ["docker-amd64", "docker-386", "docker-arm64"], "optional": true },
    "common": {
      "targets": [
        "windows-amd64", "windows-386",
        "linux-amd64", "linux-386",
        "android-arm64-v8a", "android-armeabi-v7a"
      ]
    },
    "architecture": {
      "requiredChoice": ["amd64", "386", "arm64", "all"],
      "extraChoice": ["armv7"],
      "defaultFamilies": ["windows", "linux"],
      "optInFamilies": ["android", "docker"],
      "androidMapping": {
        "amd64": "可选 x86_64，若请求但不可用必须显式失败",
        "386": "x86",
        "arm64": "arm64-v8a",
        "armv7": "armeabi-v7a"
      },
      "omitUnavailableSilently": false
    }
  },

  "workflowContract": {
    "trigger": "workflow_dispatch",
    "automaticProductionBuildOnPush": false,
    "defaultDestination": "Actions artifacts",
    "wrappers": [
      "build-all.yml", "build-windows.yml", "build-android.yml",
      "build-linux.yml", "build-docker.yml", "build-arch.yml", "build-common.yml"
    ],
    "reusable": ["reusable-desktop.yml", "reusable-android.yml", "reusable-docker.yml"],
    "filesImplemented": false,
    "matrixFailFast": false,
    "requiredFailureFailsAggregate": true,
    "unrunRuntimeStatus": "not_run",
    "inputs": ["source_ref", "preset_or_arch", "include_docker", "build_type", "publish", "release_tag"],
    "coreStep": "构建产物需附带锁定版本的核心二进制（或声明首启下载）；核心不编译，只下载 + 校验"
  },

  "statusVocabulary": {
    "planned": "已计划，尚未开始",
    "build_passed": "编译通过（不等于可运行）",
    "runtime_passed": "在目标平台实际运行并取得证据",
    "blocked": "有明确阻塞条件且已记录",
    "deferred": "明确后置，不阻塞当前阶段",
    "not_run": "未执行，不得写成通过"
  }
}
